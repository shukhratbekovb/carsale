# Carsale Core API — переменные окружения (секреты только здесь, не в коде — 09-architecture §5)
NODE_ENV=development
PORT=4000

# Инфраструктура (infra/docker-compose.yml)
DATABASE_URL=postgresql://carsale:carsale@localhost:5432/carsale
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://carsale:carsale@localhost:5672

# Object storage (MinIO локально; S3-совместимое UZ-хранилище в prod — ADR-004)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=carsale
S3_SECRET_KEY=carsale-secret
S3_BUCKET_ORIGINALS=photos-originals
S3_BUCKET_BLURRED=photos-blurred

# ML Service (внутренний, 10-integrations-api §2.4)
ML_SERVICE_URL=http://localhost:8000

# Auth (BE-1)
JWT_SECRET=change-me
# Eskiz UZ (ADR-001); в dev используется MockAdapter
ESKIZ_API_TOKEN=
